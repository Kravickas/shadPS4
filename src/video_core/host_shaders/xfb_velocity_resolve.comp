#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2DMS motion_ms;
layout(set = 0, binding = 1) uniform texture2DMS mask_ms;
layout(set = 0, binding = 2, rg16f) uniform writeonly image2D motion_out;
layout(set = 0, binding = 3, r8) uniform writeonly image2D mask_out;

// Sample 0, not an average: blending vectors of two surfaces at an edge yields motion neither has.
void main() {
    const ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(coord, imageSize(motion_out)))) {
        return;
    }
    imageStore(motion_out, coord, texelFetch(motion_ms, coord, 0));
    imageStore(mask_out, coord, texelFetch(mask_ms, coord, 0));
}
